{
  "name": "bidra",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "node --dns-result-order=ipv4first node_modules/vite/bin/vite.js build && node scripts/check-build.mjs && node scripts/build-worker.mjs",
    "dev:api": "wrangler dev --port 8787",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply bidra-local --local",
    "test:api": "node --test tests/registry.test.mjs",
    "test:bookmarks": "node --test tests/bookmarks.test.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "node --experimental-strip-types --test src/data/initiatives.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@vibe/sdk": "file:vendor/vibe-sdk-0.1.3.tgz",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.41.0",
    "maplibre-gl": "^6.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.129.0"
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}

{
  "origin": "https://bidrakartan.se",
  "manifest": {
    "version": 1,
    "id": "bidra",
    "name": "Bidrakartan",
    "permissions": [
      "profile:read",
      "storage",
      "app:content"
    ],
    "contentTemplates": [],
    "presentation": {
      "tagline": "Hitta din hjärtefråga",
      "description": "Spara initiativ för människor, djur och natur.",
      "logo": "data:image/svg+xml;base64,",
      "locale": "sv",
      "accentColor": "#e60063"
    }
  },
  "management": {
    "serviceAccess": {
      "tokenSha256": "bdb6de889ec5eb13575931c4b1524c6705c7d523e5c2608e8a67236f585aea73",
      "createTypes": [
        "bidrakartan.discovery.v1"
      ],
      "ai": true
    },
    "migrateFromOrigin": "https://bidra.opacic357667.chatgpt.site",
    "ownerHandle": "opacic",
    "redirectUris": [
      "https://bidrakartan.se/vibe-callback/",
      "https://bidrakartan.se/vibe-callback/?vibe_popup=1"
    ],
    "editorUrl": "https://bidrakartan.se/cloud-content",
    "contentTypes": [
      {
        "id": "vibe.initiative.v1",
        "name": "Initiativ",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "vibe.initiative.v1",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 160,
              "minLength": 1
            },
            "organization": {
              "type": "string",
              "maxLength": 160
            },
            "category": {
              "enum": [
                "natur",
                "manniskor",
                "djur",
                "klimat",
                "hav",
                "barn"
              ]
            },
            "region": {
              "type": "string",
              "maxLength": 160
            },
            "scope": {
              "enum": [
                "local",
                "national"
              ]
            },
            "geography": {
              "type": "string",
              "maxLength": 2000
            },
            "summary": {
              "type": "string",
              "maxLength": 600
            },
            "contribution": {
              "type": "string",
              "maxLength": 2000
            },
            "source": {
              "type": "string",
              "maxLength": 2000
            },
            "donate": {
              "type": "string",
              "maxLength": 2000
            },
            "image": {
              "type": "string",
              "maxLength": 200
            },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "keywords": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "string",
                "maxLength": 80
              }
            },
            "giving": {
              "type": "array",
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "pengar",
                  "tid"
                ]
              }
            }
          }
        },
        "publication": {
          "fields": [
            "title",
            "organization",
            "category",
            "region",
            "scope",
            "geography",
            "summary",
            "contribution",
            "source",
            "donate",
            "image",
            "coordinates",
            "keywords",
            "giving"
          ],
          "metadataFields": [
            "sourceReadAt"
          ],
          "searchFields": [
            "title",
            "summary",
            "organization",
            "keywords"
          ],
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "organization",
              "category",
              "region",
              "scope",
              "geography",
              "summary",
              "contribution",
              "source",
              "donate",
              "giving",
              "sourceReadAt"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 160,
                "minLength": 1
              },
              "organization": {
                "type": "string",
                "maxLength": 160,
                "minLength": 1
              },
              "category": {
                "enum": [
                  "natur",
                  "manniskor",
                  "djur",
                  "klimat",
                  "hav",
                  "barn"
                ]
              },
              "region": {
                "type": "string",
                "maxLength": 160,
                "minLength": 1
              },
              "scope": {
                "enum": [
                  "local",
                  "national"
                ]
              },
              "geography": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "maxLength": 600,
                "minLength": 1
              },
              "contribution": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              "source": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1,
                "pattern": "^https://[^/@]+(?:/|$)"
              },
              "donate": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1,
                "pattern": "^https://[^/@]+(?:/|$)"
              },
              "image": {
                "type": "string",
                "maxLength": 200
              },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "keywords": {
                "type": "array",
                "maxItems": 40,
                "items": {
                  "type": "string",
                  "maxLength": 80
                }
              },
              "giving": {
                "type": "array",
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "pengar",
                    "tid"
                  ]
                },
                "minItems": 1
              },
              "sourceReadAt": {
                "type": "string",
                "format": "date",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "scope": {
                      "const": "local"
                    }
                  }
                },
                "then": {
                  "required": [
                    "coordinates"
                  ],
                  "properties": {
                    "coordinates": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180
                        },
                        {
                          "type": "number",
                          "minimum": -85,
                          "maximum": 85
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                }
              }
            ]
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "checks",
              "sourceReadAt",
              "note"
            ],
            "properties": {
              "checks": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "identity",
                  "source",
                  "geography",
                  "donation"
                ],
                "properties": {
                  "identity": {
                    "const": true
                  },
                  "source": {
                    "const": true
                  },
                  "geography": {
                    "const": true
                  },
                  "donation": {
                    "const": true
                  }
                }
              },
              "sourceReadAt": {
                "type": "string",
                "format": "date"
              },
              "note": {
                "type": "string",
                "minLength": 15,
                "maxLength": 2000
              }
            }
          }
        }
      },
      {
        "id": "bidrakartan.discovery.v1",
        "name": "Insamlade förslag",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "url",
            "sourceName",
            "fetchedAt",
            "fingerprint",
            "state",
            "excerpt",
            "proposal",
            "imagePrompt",
            "warnings"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 160
            },
            "url": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^https://"
            },
            "sourceName": {
              "type": "string",
              "maxLength": 160
            },
            "fetchedAt": {
              "type": "string",
              "maxLength": 40
            },
            "publishedAt": {
              "type": "string",
              "maxLength": 100
            },
            "fingerprint": {
              "type": "string",
              "maxLength": 64
            },
            "state": {
              "enum": [
                "new",
                "accepted",
                "dismissed"
              ]
            },
            "excerpt": {
              "type": "string",
              "maxLength": 1600
            },
            "proposal": {
              "type": "object"
            },
            "imagePrompt": {
              "type": "string",
              "maxLength": 3000
            },
            "image": {
              "type": "string",
              "maxLength": 200
            },
            "warnings": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    ]
  }
}
